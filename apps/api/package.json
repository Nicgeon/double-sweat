    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "luxon": "^3.7.2",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.21.1",
