{
  "name": "@double-sweat/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:types": "tsx ../api/scripts/dump-openapi.ts src/lib/api/openapi.json && openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "build:native": "VITE_TARGET=native vite build && node scripts/inject-csp.mjs build-native",
    "build:native:test": "VITE_TARGET=native VITE_ALLOW_HTTP=true vite build && node scripts/inject-csp.mjs build-native --allow-http"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "openapi-fetch": "0.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
