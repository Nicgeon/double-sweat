<?xml version="1.0" encoding="utf-8"?>
<!-- Nur verschlüsselte Verbindungen, und nur zu Zertifikaten, denen das System vertraut (keine vom Nutzer
     nachinstallierten Zertifizierungsstellen). Der Debug-Build lockert das in src/debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
