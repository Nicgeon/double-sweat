{
  "name": "double-sweat",
  "version": "0.1.0",
  "private": true,
  "description": "Selbst gehostete Paar-Fitness-Accountability-App",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @double-sweat/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "design:build": "node scripts/design-build.mjs",
    "design:check": "node scripts/design-build.mjs --check && node scripts/check-contrast.mjs",
    "design:icons": "node scripts/design-icons.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3"
  }
}
