{
  "name": "double-sweat",
  "version": "0.2.0-rc.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Selbst gehostete Paar-Fitness-Accountability-App",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @double-sweat/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "design:build": "node scripts/design-build.mjs",
    "design:check": "node scripts/design-build.mjs --check && node scripts/check-contrast.mjs",
    "design:icons": "node scripts/design-icons.mjs",
    "dev:web": "pnpm --filter @double-sweat/web dev",
    "test:e2e": "pnpm --filter @double-sweat/web test:e2e",
    "android:icons": "node scripts/android-icons.mjs",
    "android:debug": "sh scripts/android-build.sh debug",
    "android:apk": "sh scripts/android-build.sh release",
    "android:test": "sh scripts/android-build.sh test",
    "android:debug:fcm": "sh scripts/android-build.sh debug fcm",
    "android:apk:fcm": "sh scripts/android-build.sh release fcm"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3"
  }
}
