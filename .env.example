# Double Sweat: Konfiguration. Kopieren nach .env und anpassen: cp .env.example .env
# Leere Werte gelten als "nicht gesetzt". Platzhalter wie CHANGE_ME werden beim Start abgelehnt.

# --- Server -----------------------------------------------------------------
# Öffentliche Adresse, unter der die App erreichbar ist. Pflicht für Links in Mails, CSRF-Prüfung und
# Cookies. Nur Schema + Host (+ Port), kein Unterpfad. Kamera und Push funktionieren nur mit https://.
PUBLIC_URL=https://sweat.example.org
# Bind-Adresse und Port der API. Im Container 0.0.0.0, nach außen nur über den Reverse-Proxy.
HOST=127.0.0.1
PORT=3000
# Verzeichnis für Datenbank, Fotos und Schlüssel (als Volume einbinden).
DATA_DIR=./data
# Verzeichnis mit dem gebauten Web-Frontend (im Container gesetzt).
# WEB_DIR=/app/web

# --- Registrierung ----------------------------------------------------------
# open         jeder darf ein Team gründen (nur hinter VPN/LAN sinnvoll)
# token        Team gründen nur mit SETUP_TOKEN (Standard); der Partner tritt per Einladung bei
# invite-only  Teams nur per CLI (create-team), Beitritt per Einladung
# closed       keine Registrierung über das Web
SIGNUP_MODE=token
# Erzeugen mit: openssl rand -base64 24   (mindestens 16 Zeichen)
SETUP_TOKEN=CHANGE_ME
# Höchstzahl an Teams (0 = unbegrenzt). Gilt nur für Gründungen, nicht für Beitritte.
MAX_TEAMS=0

# --- Reverse-Proxy und Netzwerk --------------------------------------------
# Adressen, deren X-Forwarded-For vertrauenswürdig ist. Schlüsselwörter: loopback, private, linklocal,
# none, dazu einzelne IPs oder CIDR-Bereiche. Ist der Port direkt aus dem Internet erreichbar: none.
TRUST_PROXY=loopback,private
# Erlaubte Origins der Android-App (kommagetrennt). Die App läuft unter https://localhost.
CORS_APP_ORIGINS=https://localhost
# Größtes erlaubtes Foto in MB.
MAX_UPLOAD_MB=12

# --- E-Mail (optional) ------------------------------------------------------
# Ohne SMTP_URL gibt es keinen Mailversand: kein "Passwort vergessen", keine Adress-Bestätigung.
# Passwörter lassen sich dann per CLI zurücksetzen (siehe README).
# Beispiel: smtps://benutzer:passwort@mail.example.org:465   oder   smtp://benutzer:passwort@mail.example.org:587
SMTP_URL=
MAIL_FROM=Double Sweat <noreply@example.org>
# STARTTLS bei smtp:// erzwingen (empfohlen). Nur für lokale Test-Mailserver auf false stellen.
SMTP_REQUIRE_TLS=true

# --- Sonstiges --------------------------------------------------------------
LOG_LEVEL=info
# Argon2id-Parameter für Passwort-Hashes (OWASP-Mindestwerte als Standard)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
