# Double Sweat: Konfiguration. Kopieren nach .env und anpassen: cp .env.example .env
# Leere Werte gelten als "nicht gesetzt". Platzhalter wie CHANGE_ME werden beim Start abgelehnt.

# --- Server -----------------------------------------------------------------
# Öffentliche Adresse, unter der die App erreichbar ist. Pflicht für Links in Mails, CSRF-Prüfung und
# Cookies. Nur Schema + Host (+ Port), kein Unterpfad. Kamera und Push funktionieren nur mit https://.
PUBLIC_URL=https://sweat.example.org
# Bind-Adresse und Port der API. Im Container 0.0.0.0, nach außen nur über den Reverse-Proxy.
HOST=127.0.0.1
PORT=3000
# Verzeichnis für Datenbank, Fotos und Schlüssel (als Volume einbinden).
DATA_DIR=./data
# Verzeichnis mit dem gebauten Web-Frontend (im Container gesetzt).
# WEB_DIR=/app/web

# Nur für deploy/docker-compose.caddy.yml (Caddy): Domain, für die das HTTPS-Zertifikat geholt wird.
# Muss zu PUBLIC_URL passen (ohne https://).
DOMAIN=sweat.example.org

# --- Registrierung ----------------------------------------------------------
# open         jeder darf ein Team gründen (nur hinter VPN/LAN sinnvoll)
# token        Team gründen nur mit SETUP_TOKEN (Standard); der Partner tritt per Einladung bei
# invite-only  Teams nur per CLI (create-team), Beitritt per Einladung
# closed       keine Registrierung über das Web
SIGNUP_MODE=token
# Erzeugen mit: openssl rand -base64 24   (mindestens 16 Zeichen)
SETUP_TOKEN=CHANGE_ME
# Höchstzahl an Teams (0 = unbegrenzt). Gilt nur für Gründungen, nicht für Beitritte.
MAX_TEAMS=0

# --- Reverse-Proxy und Netzwerk --------------------------------------------
# Adressen, deren X-Forwarded-For vertrauenswürdig ist. Schlüsselwörter: loopback, private, linklocal,
# none, dazu einzelne IPs oder CIDR-Bereiche. Ist der Port direkt aus dem Internet erreichbar: none.
TRUST_PROXY=loopback,private
# Erlaubte Origins der Android-App (kommagetrennt). Die App läuft unter https://localhost.
CORS_APP_ORIGINS=https://localhost
# Größtes erlaubtes Foto in MB.
MAX_UPLOAD_MB=12

# --- Push-Benachrichtigungen ------------------------------------------------
# Web Push (Browser/PWA) läuft über den Push-Dienst des Browser-Herstellers (Mozilla, Google, Apple). Der Inhalt
# ist Ende-zu-Ende verschlüsselt, die Metadaten (wer, wann) sieht der Hersteller. Abschalten: false.
WEBPUSH_ENABLED=true
# UnifiedPush (z. B. mit der ntfy-App, vollständig selbst hostbar; Standard für die Android-App).
UNIFIEDPUSH_ENABLED=true
# Hosts, die auch lokale Adressen oder http nutzen dürfen, z. B. ein ntfy im eigenen Netz (kommagetrennt).
# Alle anderen Push-Ziele müssen https sein und öffentlich auflösen (Schutz vor SSRF).
PUSH_ALLOWED_HOSTS=
# Kontakt für den Push-Dienst (mailto:… oder https://…). Standard: PUBLIC_URL.
# VAPID_SUBJECT=mailto:admin@example.org
# FCM (Firebase Cloud Messaging, optional): Push für Android-Geräte ohne UnifiedPush-App. Braucht ein eigenes
# Firebase-Projekt und die App-Version mit FCM (pnpm android:apk:fcm), siehe README. Der Inhalt läuft Ende-zu-Ende
# verschlüsselt; Google sieht nur, dass und wann eine Nachricht an ein Gerät geht.
FCM_ENABLED=false
# JSON-Datei des Firebase-Dienstkontos (Firebase-Konsole, Projekteinstellungen, Dienstkonten, neuen Schlüssel erzeugen).
# Der Pfad gilt IM Container (dort ist nur das Volume /data sichtbar, nicht der Projektordner). Ablegen mit:
#   ./scripts/fcm-key.sh pfad/zur/dienstkonto.json
# Das ist ein Geheimnis: Wer die Datei hat, kann Nachrichten an alle Geräte des Projekts senden.
# FCM_SERVICE_ACCOUNT_FILE=/data/fcm-service-account.json

# --- E-Mail (optional) ------------------------------------------------------
# Ohne SMTP_URL gibt es keinen Mailversand: kein "Passwort vergessen", keine Adress-Bestätigung.
# Passwörter lassen sich dann per CLI zurücksetzen (siehe README).
# Beispiel: smtps://benutzer:passwort@mail.example.org:465   oder   smtp://benutzer:passwort@mail.example.org:587
# Benutzer und Passwort stehen in der URL: @ im Benutzernamen als %40, Sonderzeichen im Passwort prozentkodiert
# (# = %23, / = %2F, ? = %3F, : = %3A, Leerzeichen = %20).
#
# Gmail (mit Google-Konto, Bestätigung in zwei Schritten und "App-Passwort", siehe README):
#   SMTP_URL=smtps://deine.adresse%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
#   MAIL_FROM=Double Sweat <deine.adresse@gmail.com>
# Anderer Anbieter: Host, Port und Benutzer stehen in dessen SMTP-Hilfe (465 = smtps://, 587 = smtp:// mit STARTTLS).
SMTP_URL=
MAIL_FROM=Double Sweat <noreply@example.org>
# STARTTLS bei smtp:// erzwingen (empfohlen). Nur für lokale Test-Mailserver auf false stellen.
SMTP_REQUIRE_TLS=true

# --- Sonstiges --------------------------------------------------------------
LOG_LEVEL=info
# Nur zum Testen von Wochenwechseln: verschiebt die Serveruhr (Stunden). In Produktion verboten.
# DEV_CLOCK_OFFSET_HOURS=0
# Argon2id-Parameter für Passwort-Hashes (OWASP-Mindestwerte als Standard)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
